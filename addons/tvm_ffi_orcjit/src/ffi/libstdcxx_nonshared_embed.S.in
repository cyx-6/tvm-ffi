/*
 * Embed libstdc++_nonshared.a in .rodata. The archive is not linked into this
 * DSO: ORC consumes these bytes through StaticLibraryDefinitionGenerator and
 * materializes only members required by JITed objects.
 */
    .section .rodata
    .balign 8
    .hidden libstdcxx_nonshared_archive_start
    .global libstdcxx_nonshared_archive_start
libstdcxx_nonshared_archive_start:
    .incbin "@LIBSTDCXX_NONSHARED_PATH@"
    .hidden libstdcxx_nonshared_archive_end
    .global libstdcxx_nonshared_archive_end
libstdcxx_nonshared_archive_end:
